PORT=8787
APP_URL=http://localhost:5173
DATABASE_PATH=./data/wataseru.db
UPLOAD_DIR=./data/uploads
SESSION_SECRET=change-me

# LLM（サーバのみ。ブラウザに出さない）
XAI_API_KEY=
# または OpenAI 互換
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=grok-4.5

# 文字起こし（Whisper 系）。未設定なら「書いてください」に戻す
OPENAI_API_KEY_TRANSCRIBE=
TRANSCRIBE_MODEL=whisper-1

# マジックリンク（未設定なら開発時はレスポンスにリンクを返す）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ワタセル <noreply@localhost>
AUTH_DEV_LINKS=1
